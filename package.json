{
  "name": "rn-starter",
  "version": "2.2.0",
  "author": "Gabriel Hofman <gabriel.hofman.00@gmail.com>",
  "description": "Default starter with basic builtins and configs used in my React Native projects",
  "type": "module",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsyirvo/react-native-starter.git"
  },
  "bugs": {
    "url": "https://github.com/tsyirvo/react-native-starter/issues"
  },
  "keywords": [
    "React Native",
    "Starter",
    "Boilerplate",
    "Expo",
    "Development Build"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=26",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start:dev": "doppler run --config dev -- env APP_ENV=development EXPO_NO_DOTENV=1 expo start --dev-client",
    "start:staging": "doppler run --config stg -- env APP_ENV=staging EXPO_NO_DOTENV=1 expo start --no-dev --minify",
    "start:production": "doppler run --config prd -- env APP_ENV=production EXPO_NO_DOTENV=1 expo start --no-dev --minify",
    "//// BUILDS ////": "",
    "build:dev:ios": "doppler run --config dev -- env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform ios --local",
    "build:dev:android": "doppler run --config dev -- env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform android --local",
    "build:dev-device:ios": "doppler run --config dev -- env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development-device --platform ios --local",
    "build:stg:ios": "doppler run --config stg -- env APP_ENV=staging EXPO_NO_DOTENV=1 eas build --profile staging --platform ios --local",
    "build:stg:android": "doppler run --config stg -- env APP_ENV=staging EXPO_NO_DOTENV=1 eas build --profile staging --platform android --local",
    "build:prod:ios": "doppler run --config prd -- env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform ios --local",
    "build:prod:android": "doppler run --config prd -- env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform android --local",
    "//// TESTS ////": "",
    "test": "jest",
    "test:e2e": "doppler run --config dev -- maestro test ./e2e/authNavigation.yaml",
    "test:coverage": "jest --coverage",
    "//// QUALITY ////": "",
    "lint:ts": "tsc",
    "lint": "biome check --write --files-ignore-unknown=true ./",
    "lint:ci": "biome ci --files-ignore-unknown=true ./",
    "format": "biome format --write --files-ignore-unknown=true ./",
    "format:check": "biome format --files-ignore-unknown=true ./",
    "//// UTILITIES ////": "",
    "generate:icons": "react-native-nano-icons",
    "skills:check": "bun scripts/skills.ts check",
    "skills:upgrade": "bun scripts/skills.ts upgrade",
    "//// STORYBOOK ////": "",
    "storybook:generate": "sb-rn-get-stories",
    "start:storybook": "doppler run --config dev -- env APP_ENV=development EXPO_NO_DOTENV=1 STORYBOOK_ENABLED=true expo start",
    "//// GIT HOOKS ////": "",
    "hooks:install": "mise run hooks:install",
    "hooks:check": "mise run hooks:check",
    "hooks:fix": "mise run hooks:fix",
    "//// MISC ////": "",
    "clean:watchman": "watchman watch-del-all",
    "perf:bundle": "bunx react-native-bundle-visualizer"
  },
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "@hookform/resolvers": "5.2.2",
    "@legendapp/list": "3.5.0",
    "@legendapp/state": "3.0.0-beta.48",
    "@posthog/react-native-plugin": "2.12.6",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/query-async-storage-persister": "5.90.18",
    "@tanstack/react-query": "5.90.16",
    "@tanstack/react-query-persist-client": "5.90.18",
    "dayjs": "1.11.19",
    "expo": "^58.0.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.3",
    "expo-observe": "~58.0.15",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.17",
    "i18next": "25.7.3",
    "intl-pluralrules": "2.0.1",
    "posthog-react-native": "4.66.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.70.0",
    "react-i18next": "16.5.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "4.3.2",
    "react-native-nano-icons": "1.0.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-permissions": "5.6.1",
    "react-native-purchases": "10.8.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "2.3.3",
    "react-native-unistyles": "3.3.0",
    "react-native-worklets": "0.13.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native/jest-preset": "0.88.0",
    "@storybook/addon-ondevice-actions": "10.7.0",
    "@storybook/addon-ondevice-backgrounds": "10.7.0",
    "@storybook/addon-ondevice-controls": "10.7.0",
    "@storybook/react": "10.6.3",
    "@storybook/react-native": "10.7.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.0",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-remove-console": "6.9.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "storybook": "10.6.3",
    "test-renderer": "1.3.0",
    "tsc-files": "1.1.4",
    "typescript": "~6.0.3",
    "ultracite": "^8.0.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "trustedDependencies": [
    "@sentry/cli"
  ],
  "patchedDependencies": {
    "ultracite@8.0.1": "patches/ultracite@8.0.1.patch"
  }
}
