{
  "name": "rn-starter",
  "version": "2.2.0",
  "update": "0",
  "author": "Gabriel Hofman <gabriel.hofman.00@gmail.com>",
  "description": "Default starter with basic builtins and configs used in my React Native projects",
  "type": "module",
  "main": "expo-router/entry",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsyirvo/react-native-starter.git"
  },
  "bugs": {
    "url": "https://github.com/tsyirvo/react-native-starter/issues"
  },
  "keywords": [
    "React Native",
    "Starter",
    "Boilerplate",
    "Expo",
    "Development Build"
  ],
  "license": "ISC",
  "engines": {
    "yarn": ">=4",
    "node": ">=22"
  },
  "scripts": {
    "start:dev": "APP_ENV=development doppler run -p rn-starter -c dev -- expo start --dev-client",
    "start:staging": "APP_ENV=staging expo start --no-dev --minify",
    "start:production": "APP_ENV=production expo start --no-dev --minify",
    "//// BUILDS ////": "",
    "build:dev:ios": "doppler run -p rn-starter -c dev -- eas build --profile development --platform ios --local",
    "build:dev:android": "doppler run -p rn-starter -c dev -- eas build --profile development --platform android --local",
    "build:dev-device:ios": "doppler run -p rn-starter -c dev -- eas build --profile development-device --platform ios --local",
    "build:staging:ios": "APP_ENV=staging eas build --profile staging --platform ios --local",
    "build:staging:android": "APP_ENV=staging eas build --profile staging --platform android --local",
    "build:production:ios": "APP_ENV=production eas build --profile production --platform ios --local",
    "build:production:android": "APP_ENV=production eas build --profile production --platform android --local",
    "//// TESTS ////": "",
    "test": "jest --coverage=false",
    "test:e2e": "doppler run -p rn-starter -c dev -- maestro test ./e2e/authNavigation.yaml",
    "test:coverage": "jest",
    "//// QUALITY ////": "",
    "lint:ts": "yarn tsc",
    "lint": "eslint --cache ./ --ext .js,.ts,.tsx,.json --fix",
    "prettify": "yarn prettier --write './**/*.{js,ts,tsx}' '!.rnstorybook/storybook.requires.ts'",
    "pretty:check": "yarn prettier --check './**/*.{js,ts,tsx}' '!.rnstorybook/storybook.requires.ts'",
    "//// UTILITIES ////": "",
    "codegen": "graphql-codegen --config codegen.ts",
    "image:add": "ts-node -T ./scripts/importImages/index.ts",
    "generate:icons": "svgr --config-file src/shared/icons/svgs/config/svgrConfig.js --svgo-config src/shared/icons/svgs/config/svgoConfig.js --index-template src/shared/icons/svgs/config/index-template.js --template src/shared/icons/svgs/config/icon-template.js --out-dir src/shared/icons/components -- src/shared/icons/svgs && eslint './src/shared/icons/components/**/*.{ts,tsx}' --ext .ts,.tsx --fix --quiet && prettier --write './src/shared/icons/components/**/*.{ts,tsx}'",
    "//// STORYBOOK ////": "",
    "storybook:generate": "sb-rn-get-stories",
    "start:storybook": "STORYBOOK_ENABLED=true doppler run -p rn-starter -c dev -- expo start",
    "//// VERSIONNING ////": "",
    "version:bump": "standard-version --skip.commit --skip.changelog --skip.tag",
    "version:tag": "standard-version",
    "//// MISC ////": "",
    "clean:watchman": "watchman watch-del-all",
    "perf:bundle": "npx react-native-bundle-visualizer",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@formatjs/intl-getcanonicallocales": "2.5.6",
    "@gorhom/bottom-sheet": "5.2.6",
    "@hookform/resolvers": "5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/restyle": "2.4.5",
    "@tanstack/query-async-storage-persister": "5.90.4",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-query-persist-client": "5.90.4",
    "dayjs": "1.11.18",
    "eas-build-cache-provider": "16.4.2",
    "expo": "^54.0.0",
    "expo-application": "~7.0.7",
    "expo-asset": "~12.0.9",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.15",
    "expo-device": "~8.0.9",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.9",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-network": "~8.0.7",
    "expo-router": "~6.0.12",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-store-review": "~9.0.8",
    "expo-updates": "~29.0.12",
    "graphql": "16.11.0",
    "graphql-request": "7.2.0",
    "i18next": "25.6.0",
    "immer": "10.1.3",
    "intl-pluralrules": "2.0.1",
    "lodash.isequal": "4.5.0",
    "lodash.isnil": "4.0.0",
    "lodash.memoize": "4.1.2",
    "onesignal-expo-plugin": "2.0.3",
    "posthog-react-native": "4.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "6.0.0",
    "react-hook-form": "7.65.0",
    "react-i18next": "16.0.0",
    "react-native": "0.81.4",
    "react-native-device-info": "14.0.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-mmkv": "3.3.3",
    "react-native-onesignal": "5.2.13",
    "react-native-permissions": "5.4.2",
    "react-native-purchases": "9.5.4",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "2.3.3",
    "react-native-worklets": "0.5.1",
    "semver": "7.7.2",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "1.15.0",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/client-preset": "5.1.0",
    "@graphql-codegen/introspection": "5.0.0",
    "@graphql-codegen/typescript": "5.0.2",
    "@graphql-codegen/typescript-operations": "5.0.2",
    "@graphql-codegen/typescript-react-query": "6.1.1",
    "@react-native-community/datetimepicker": "8.4.5",
    "@react-native-community/slider": "5.0.1",
    "@storybook/addon-ondevice-actions": "9.1.4",
    "@storybook/addon-ondevice-backgrounds": "9.1.4",
    "@storybook/addon-ondevice-controls": "9.1.4",
    "@storybook/react": "9.1.10",
    "@storybook/react-native": "9.1.4",
    "@svgr/cli": "8.1.0",
    "@testing-library/react-native": "13.3.3",
    "@types/fs-extra": "11.0.4",
    "@types/imagemin": "8.0.0",
    "@types/imagemin-mozjpeg": "8.0.1",
    "@types/jest": "29.5.14",
    "@types/lodash.isequal": "4.5.8",
    "@types/lodash.isnil": "4.0.9",
    "@types/lodash.memoize": "4.1.9",
    "@types/react": "~19.1.10",
    "@types/react-navigation": "3.4.0",
    "@types/semver": "7.7.1",
    "@types/sharp": "0.31.0",
    "app-icon-badge": "0.1.2",
    "babel-plugin-transform-remove-console": "6.9.4",
    "dotenv": "17.2.3",
    "eslint": "9.28.0",
    "eslint-config-tsyirvo-react-native": "2.1.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "fs-extra": "11.3.2",
    "imagemin": "7.0.1",
    "imagemin-mozjpeg": "9.0.0",
    "imagemin-pngquant": "9.0.2",
    "is-image": "4.0.0",
    "jest": "29.7.0",
    "jest-expo": "~54.0.12",
    "lefthook": "1.13.6",
    "patch-package": "8.0.1",
    "pinst": "3.0.0",
    "postinstall-postinstall": "2.1.0",
    "prettier": "3.2.5",
    "sharp": "0.31.1",
    "standard-version": "9.5.0",
    "storybook": "9.1.10",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|zustand|immer)"
    ],
    "moduleNameMapper": {
      "^\\$(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js",
      "./src/domain/testing/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "e2e/"
    ],
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js|jsx)$",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/app.config.ts",
      "!**/**.e2e.ts",
      "!src/components/icons/components/**",
      "!**/stories/**",
      "!**/**.types.ts"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "packageManager": "yarn@4.4.1"
}
