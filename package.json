{
  "name": "rn-starter",
  "version": "2.2.0",
  "update": "0",
  "author": "Gabriel Hofman <gabriel.hofman.00@gmail.com>",
  "description": "Default starter with basic builtins and configs used in my React Native projects",
  "type": "module",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsyirvo/react-native-starter.git"
  },
  "bugs": {
    "url": "https://github.com/tsyirvo/react-native-starter/issues"
  },
  "keywords": [
    "React Native",
    "Starter",
    "Boilerplate",
    "Expo",
    "Development Build"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=26",
    "bun": ">=1.4"
  },
  "scripts": {
    "start:dev": "APP_ENV=development doppler run -- expo start --dev-client",
    "start:staging": "APP_ENV=staging expo start --no-dev --minify",
    "start:production": "APP_ENV=production expo start --no-dev --minify",
    "//// BUILDS ////": "",
    "build:dev:ios": "doppler run -- eas build --profile development --platform ios --local",
    "build:dev:android": "doppler run -- eas build --profile development --platform android --local",
    "build:dev-device:ios": "doppler run -- eas build --profile development-device --platform ios --local",
    "build:staging:ios": "APP_ENV=staging eas build --profile staging --platform ios --local",
    "build:staging:android": "APP_ENV=staging eas build --profile staging --platform android --local",
    "build:production:ios": "APP_ENV=production eas build --profile production --platform ios --local",
    "build:production:android": "APP_ENV=production eas build --profile production --platform android --local",
    "//// TESTS ////": "",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest --cache --coverage=false",
    "test:e2e": "doppler run -- maestro test ./e2e/authNavigation.yaml",
    "test:coverage": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest",
    "//// QUALITY ////": "",
    "lint:ts": "tsc",
    "lint": "biome check --write --files-ignore-unknown=true ./",
    "lint:ci": "biome ci --files-ignore-unknown=true ./",
    "format": "biome format --write --files-ignore-unknown=true ./",
    "format:check": "biome format --files-ignore-unknown=true ./",
    "//// UTILITIES ////": "",
    "generate:icons": "svgr --config-file src/shared/icons/svgs/config/svgrConfig.js --svgo-config src/shared/icons/svgs/config/svgoConfig.js --index-template src/shared/icons/svgs/config/index-template.js --template src/shared/icons/svgs/config/icon-template.js --out-dir src/shared/icons/components -- src/shared/icons/svgs && biome check --write --files-ignore-unknown=true ./src/shared/icons/components/",
    "//// STORYBOOK ////": "",
    "storybook:generate": "sb-rn-get-stories",
    "start:storybook": "APP_ENV=development STORYBOOK_ENABLED=true doppler run -- expo start",
    "//// VERSIONNING ////": "",
    "version:bump": "standard-version --skip.commit --skip.changelog --skip.tag",
    "version:tag": "standard-version",
    "//// GIT HOOKS ////": "",
    "hooks:install": "mise run hooks:install",
    "hooks:check": "mise run hooks:check",
    "hooks:fix": "mise run hooks:fix",
    "//// MISC ////": "",
    "clean:watchman": "watchman watch-del-all",
    "perf:bundle": "bunx react-native-bundle-visualizer"
  },
  "dependencies": {
    "@formatjs/intl-getcanonicallocales": "3.1.2",
    "@gorhom/bottom-sheet": "5.2.14",
    "@hookform/resolvers": "5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "5.90.18",
    "@tanstack/react-query": "5.90.16",
    "@tanstack/react-query-persist-client": "5.90.18",
    "dayjs": "1.11.19",
    "expo": "^57.0.0",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.15",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-updates": "~57.0.19",
    "i18next": "25.7.3",
    "immer": "11.1.3",
    "intl-pluralrules": "2.0.1",
    "lodash.debounce": "4.0.8",
    "lodash.isequal": "4.5.0",
    "lodash.isnil": "4.0.0",
    "lodash.memoize": "4.1.2",
    "posthog-react-native": "4.66.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "6.0.2",
    "react-hook-form": "7.70.0",
    "react-i18next": "16.5.1",
    "react-native": "0.86.3",
    "react-native-device-info": "15.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-permissions": "5.6.1",
    "react-native-purchases": "10.8.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "2.3.3",
    "react-native-unistyles": "3.3.0",
    "react-native-worklets": "0.10.1",
    "semver": "7.7.3",
    "zod": "4.3.5",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native/jest-preset": "0.86.3",
    "@storybook/addon-ondevice-actions": "10.5.1",
    "@storybook/addon-ondevice-backgrounds": "10.5.1",
    "@storybook/addon-ondevice-controls": "10.5.1",
    "@storybook/react": "10.5.10",
    "@storybook/react-native": "10.5.1",
    "@svgr/cli": "8.1.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/lodash.debounce": "4.0.9",
    "@types/lodash.isequal": "4.5.8",
    "@types/lodash.isnil": "4.0.9",
    "@types/lodash.memoize": "4.1.9",
    "@types/node": "26.4.0",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "@types/semver": "7.7.1",
    "app-icon-badge": "0.1.2",
    "babel-plugin-transform-remove-console": "6.9.4",
    "@biomejs/biome": "^2.5.11",
    "ultracite": "^7.10.7",
    "dotenv": "17.2.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "standard-version": "9.5.0",
    "storybook": "10.5.10",
    "tsc-files": "1.1.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/app.config.ts",
      "!**/**.e2e.ts",
      "!src/components/icons/components/**",
      "!**/stories/**",
      "!**/**.types.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "moduleNameMapper": {
      "^\\$(.*)$": "<rootDir>/src/$1"
    },
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js",
      "react-native-unistyles/mocks",
      "./src/domain/theme/unistyles.ts",
      "./src/domain/testing/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "e2e/"
    ],
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js|jsx)$",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|standard-navigation|@sentry/react-native|native-base|react-native-svg|zustand|immer|storybook|@storybook/.*)"
    ]
  },
  "trustedDependencies": [
    "@sentry/cli"
  ],
  "overrides": {
    "@storybook/react-native-ui": "10.5.1"
  },
  "packageManager": "bun@1.4.0"
}
