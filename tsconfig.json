{
  "extends": "eslint-config-tsyirvo-react-native/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "baseUrl": ".",
    "paths": {
      "$*": ["src/*"],
      "*": ["*", "*.ios.tsx", "*.android.tsx"]
    },
    "plugins": [
      {
        "name": "@0no-co/graphqlsp",
        "schema": "./src/generated/graphql.schema.json"
      }
    ]
  },
  "exclude": ["node_modules", "__mocks__"],
  "include": [
    "**/*.js",
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "eslint.config.mjs",
    "metro.config.cjs"
  ]
}
