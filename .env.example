EXPO_APPLE_TEAM_ID=""
EXPO_UPDATE_URL=""

API_URL=""
ITUNES_ITEM_ID=""

SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
POSTHOG_API_KEY=""
REVENUE_CAT_APPLE_API_KEY=""
REVENUE_CAT_ANDROID_API_KEY=""

# Optional; leave unset or false outside Storybook.
# STORYBOOK_ENABLED="false"
