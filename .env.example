# Documentation only: do not copy this to a runtime .env file.
# Set non-empty values in the matching Doppler config (dev / stg / prd).

# Use development in dev, staging in stg and production in prd.
APP_ENV=""
# Use 1 in all configs. This value stops Expo from reading .env files.
EXPO_NO_DOTENV="1"

APP_NAME=""
