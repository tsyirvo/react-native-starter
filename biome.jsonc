{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "!!**/babel.config.js",
      "!!**/metro.config.cjs",
      "!!**/env.js",
      "!!**/src/shared/icons/font",
      "!!**/.rnstorybook"
    ]
  },
  // Biome 2.6 only supports CommonMark, not our GFM tables/task lists.
  // Keep Markdown linting, but leave formatting to the documentation authors.
  "markdown": {
    "parser": {
      "frontmatter": true
    },
    "formatter": {
      "enabled": false
    }
  },
  "javascript": {
    "globals": [
      "__DEV__",
      "jest",
      "it",
      "test",
      "describe",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "expect"
    ],
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        // Separate packages, `$` aliases and relative paths with a blank line.
        // Explicit groups make Biome enforce and autofix the separators.
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":URL:",
                ":BUN:",
                ":NODE:",
                ":PACKAGE_WITH_PROTOCOL:",
                ":PACKAGE:"
              ],
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        },
        // Don't auto-sort package.json keys
        "useSortedPackageJson": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        // Expo SDK namespaces and Jest spyOn mocks are intentional.
        "noNamespaceImport": "off",
        // Inline callbacks are idiomatic here; React Compiler is enabled.
        "noJsxPropsBind": "off"
      },
      "style": {
        // PascalCase components and camelCase hooks, utilities and config files.
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["camelCase", "PascalCase"]
          }
        },
        // Shared client state lives behind `$infra/store` hooks and actions.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "zustand": "Use the Legend State store from `$infra/store`."
            },
            "patterns": [
              {
                "group": ["@legendapp/state", "@legendapp/state/**"],
                "message": "Use the hooks and actions exported by `$infra/store`."
              }
            ]
          }
        }
      },
      "complexity": {
        "noVoid": "off"
      }
    }
  },
  "overrides": [
    {
      // Package-named mocks/augmentations and existing CLI scripts use kebab-case.
      "includes": [
        "__mocks__/**",
        "src/types/react-query.d.ts",
        "scripts/**",
        ".github/scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase", "PascalCase", "kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      // Route filenames are URL segments, so they follow Expo Router's kebab-case.
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      // The icon registry intentionally selects a generated component by name.
      "includes": ["src/shared/icons/Icon.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noDynamicNamespaceImportAccess": "off"
          }
        }
      }
    },
    {
      // Unistyles prop-to-style mapping objects (Box/Row/Stack primitives)
      // are linear ternaries that read better than the 20 default budget.
      "includes": ["src/shared/uiKit/primitives/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 25
              }
            }
          }
        }
      }
    },
    {
      // The store owns Legend State. `observer` relies on `.get()` in render,
      // which React Compiler memoizes; read values with `useValue` instead.
      "includes": ["src/infra/store/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zustand": "Use Legend State observables.",
                  "@legendapp/state/react": {
                    "importNames": ["observer", "reactiveObserver"],
                    "message": "Read observables with `useValue`; `observer` is incompatible with React Compiler."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/icons/svgs/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
