{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["./biome.base.jsonc", "./biome.debt.jsonc"],
  "files": {
    "includes": [
      "!!**/babel.config.js",
      "!!**/metro.config.cjs",
      "!!**/env.js",
      "!!**/src/shared/icons/font",
      "!!**/.rnstorybook"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        // Shared client state lives behind `$infra/store` hooks and actions.
        // The UI kit has no root barrel: it would load every component's
        // dependencies (expo-router, expo-image…) into each Jest test.
        // `$shared/a11y` owns the platform workarounds for screen readers.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "$shared/uiKit": "Import from the component entry, for example `$shared/uiKit/primitives` or `$shared/uiKit/button`.",
              "react-native": {
                "importNames": ["AccessibilityInfo"],
                "message": "Use the hooks and `announce` exported by `$shared/a11y`."
              },
              "react-native-reanimated": {
                "importNames": ["useReducedMotion"],
                "message": "It reads the setting only at launch. Use `useIsReduceMotionEnabled` from `$shared/a11y`."
              }
            },
            "patterns": [
              {
                "group": ["@legendapp/state", "@legendapp/state/**"],
                "message": "Use the hooks and actions exported by `$infra/store`."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Route filenames are URL segments, so they follow Expo Router's kebab-case.
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      // The logger owns development console output.
      "includes": ["src/infra/logger/logger.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      // The icon registry intentionally selects a generated component by name.
      "includes": ["src/shared/icons/Icon.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noDynamicNamespaceImportAccess": "off"
          }
        }
      }
    },
    {
      // Unistyles prop-to-style mapping objects (Box/Row/Stack primitives)
      // are linear ternaries that read better than the 20 default budget.
      "includes": ["src/shared/uiKit/primitives/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 25
              }
            }
          }
        }
      }
    },
    {
      // The store owns Legend State. `observer` relies on `.get()` in render,
      // which React Compiler memoizes; read values with `useValue` instead.
      "includes": ["src/infra/store/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "$shared/uiKit": "Import from the component entry, for example `$shared/uiKit/primitives`.",
                  "@legendapp/state/react": {
                    "importNames": ["observer", "reactiveObserver"],
                    "message": "Read observables with `useValue`; `observer` is incompatible with React Compiler."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      // The a11y module wraps the screen reader and reduce motion APIs.
      "includes": ["src/shared/a11y/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "$shared/uiKit": "Import from the component entry, for example `$shared/uiKit/primitives`."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/icons/svgs/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
