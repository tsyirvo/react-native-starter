amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

min_hk_version = "2.13.0"
fail_fast = true

local const codeGlob = List(
  "**/*.js",
  "**/*.cjs",
  "**/*.mjs",
  "**/*.jsx",
  "**/*.ts",
  "**/*.tsx",
  "**/*.json",
  "**/*.jsonc"
)

local const tsGlob = List("**/*.ts", "**/*.tsx")

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }

  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ["biome"] {
        glob = codeGlob
        batch = true
        check = "bunx biome check --files-ignore-unknown=true --no-errors-on-unmatched {{files}}"
        fix = "bunx biome check --write --files-ignore-unknown=true --no-errors-on-unmatched {{files}}"
      }
      ["typecheck"] {
        depends = "biome"
        glob = tsGlob + List("**/tsconfig*.json")
        check = "bun run typecheck"
      }
      ["test"] {
        depends = "biome"
        glob = tsGlob
        check = "bun run test:related {{files}}"
      }
      ["gitleaks"] = (Builtins.gitleaks) {
        scan = "staged"
      }
    }
  }

  ["pre-push"] {
    steps {
      ["check"] { check = "bun run check" }
      ["typecheck"] { check = "bun run typecheck" }
    }
  }

  // Doppler keeps its setup per directory, so each new worktree needs one.
  ["post-checkout"] {
    steps {
      ["doppler-setup"] {
        step_condition = "is_branch_checkout"
        check = "sh scripts/setup-doppler.sh"
      }
    }
  }
}
